APP_NAME="Coding AI Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
