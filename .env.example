APP_NAME="Coding AI Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
# Optional localhost port with compose.database-access.yaml
DB_FORWARD_PORT=5432
DB_DATABASE=coding_assistant
DB_USERNAME=coding_assistant
DB_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Phase 2: server-only credentials. Select a text model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CONTEXT_WINDOW=0
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_INPUT_CHARS=24000
DB_QUEUE_RETRY_AFTER=210
