APP_NAME="Coding AI Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
# Optional localhost port with compose.database-access.yaml
DB_FORWARD_PORT=5432
DB_DATABASE=coding_assistant
DB_USERNAME=coding_assistant
DB_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Phase 2: server-only credentials. Select a text model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CONTEXT_WINDOW=0
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_INPUT_CHARS=24000
DB_QUEUE_RETRY_AFTER=210

# Phase 3: private CPU embedding service; generate a random shared token.
INTELLIGENCE_URL=http://intelligence:8001
INTELLIGENCE_TOKEN=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=aa8f8b060edb00e03bfdd08813a2949946c8ba55
EMBEDDING_VERSION=bge-small-en-v1.5-local-v1
EMBEDDING_DIMENSIONS=384
MEMORY_MIN_SIMILARITY=0.65

# Optional Docker read-only repository mount (see README). Never mount your home directory.
REPOSITORY_HOST_ROOT=

# Phase 5: optional local generation; embeddings keep their separate profile.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=
OLLAMA_CONTEXT_WINDOW=8192
OPENAI_TOKENIZER=o200k_base
# Additional unique model IDs only; see README for the public model schema.
AI_MODELS_JSON=[]
CHAT_MAX_TURNS=100
AI_SAFETY_TOKENS=512
AI_RECENT_HISTORY_PAIRS=6
# UTC daily application-estimated budgets, in micro-USD (1 USD = 1000000).
AI_DAILY_USER_BUDGET_MICRO_USD=10000000
AI_DAILY_PROJECT_BUDGET_MICRO_USD=50000000
AI_DAILY_ORGANIZATION_BUDGET_MICRO_USD=100000000
# Conservative reservation rates only when actual model pricing is unconfigured.
AI_RESERVATION_INPUT_PRICE_PER_MILLION=100
AI_RESERVATION_OUTPUT_PRICE_PER_MILLION=300
